{
  "cleanUrls": true,
  "redirects": [
    { "source": "/lizzietours-index", "destination": "/real-estate-ai-tours/", "permanent": true },
    { "source": "/lizzietours-index.html", "destination": "/real-estate-ai-tours/", "permanent": true },
    { "source": "/more", "destination": "/make-more-money/", "permanent": true },
    { "source": "/more/", "destination": "/make-more-money/", "permanent": true },
    { "source": "/more/index.html", "destination": "/make-more-money/", "permanent": true },
    { "source": "/pumamala-social.mp4", "destination": "/pumamala/pumamala-social.mp4", "permanent": true },
    { "source": "/dfb-dashboard", "destination": "/dfb", "permanent": true },
    { "source": "/dfb-dashboard.html", "destination": "/dfb", "permanent": true },
    { "source": "/elua/elua-1.jpg", "destination": "/elua/elua-report.jpg", "permanent": true },
    { "source": "/elua/elua-2.jpg", "destination": "/elua/elua-explore.jpg", "permanent": true },
    { "source": "/elua/elua-3.jpg", "destination": "/elua/elua-hero.jpg", "permanent": true },
    { "source": "/elua-ux/elua-report.jpg", "destination": "/elua/elua-report.jpg", "permanent": true },
    { "source": "/elua-ux/elua-explore.jpg", "destination": "/elua/elua-explore.jpg", "permanent": true },
    { "source": "/elua-ux/elua-hero.jpg", "destination": "/elua/elua-hero.jpg", "permanent": true },
    { "source": "/elua/elua", "destination": "/elua", "permanent": true },
    { "source": "/elua/elua/index.html", "destination": "/elua", "permanent": true },
    { "source": "/elua/elua/elua-1.jpg", "destination": "/elua/elua-report.jpg", "permanent": true },
    { "source": "/elua/elua/elua-2.jpg", "destination": "/elua/elua-explore.jpg", "permanent": true },
    { "source": "/elua/elua/elua-3.jpg", "destination": "/elua/elua-hero.jpg", "permanent": true },
    { "source": "/elua/elua/:path*", "destination": "/elua/:path*", "permanent": true },
    { "source": "/hvac4", "destination": "/hvac4service", "statusCode": 301 },
    { "source": "/hvac4/", "destination": "/hvac4service", "statusCode": 301 },
    { "source": "/hvac4/:path*", "destination": "/hvac4service/:path*", "statusCode": 301 },
    { "source": "/4service", "destination": "/hvac4service", "statusCode": 301 },
    { "source": "/4service/", "destination": "/hvac4service", "statusCode": 301 },
    { "source": "/4service/:path*", "destination": "/hvac4service/:path*", "statusCode": 301 },
    { "source": "/credit-climb/static", "destination": "/credit-climb", "statusCode": 307 },
    { "source": "/credit-climb/static/:path*", "destination": "/credit-climb", "statusCode": 307 }
  ],
  "headers": [
    {
      "source": "/dashboard",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/dashboard/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/api/crm",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/credit-climb",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/credit-climb/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/credit-climb.txt",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/api/credit-climb",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/dashboard", "has": [{ "type": "query", "key": "k" }], "destination": "/api/unlock" },
    { "source": "/dashboard/", "has": [{ "type": "query", "key": "k" }], "destination": "/api/unlock" },
    { "source": "/dashboard/index.html", "has": [{ "type": "query", "key": "k" }], "destination": "/api/unlock" },
    { "source": "/dashboard", "has": [{ "type": "query", "key": "key" }], "destination": "/api/unlock" },
    { "source": "/dashboard/", "has": [{ "type": "query", "key": "key" }], "destination": "/api/unlock" },
    { "source": "/built", "destination": "/portfolio" },
    { "source": "/built/", "destination": "/portfolio" },
    { "source": "/workshop", "destination": "/trade-workshop/landing" },
    { "source": "/workshop/registered", "destination": "/trade-workshop/registered" },
    { "source": "/hvac-workshop", "destination": "/trade-workshop/landing" },
    { "source": "/electrician-workshop", "destination": "/trade-workshop/landing" },
    { "source": "/plumbing-workshop", "destination": "/trade-workshop/landing" },
    { "source": "/hvac-workshop/registered", "destination": "/trade-workshop/registered" },
    { "source": "/electrician-workshop/registered", "destination": "/trade-workshop/registered" },
    { "source": "/plumbing-workshop/registered", "destination": "/trade-workshop/registered" },
    { "source": "/less-admin", "destination": "/more/ai-operations" },
    { "source": "/less-admin/", "destination": "/more/ai-operations" },
    { "source": "/credit-climb", "destination": "/api/credit-climb" },
    { "source": "/credit-climb/", "destination": "/api/credit-climb" },
    { "source": "/credit-climb.txt", "destination": "/api/credit-climb?file=index.txt" },
    { "source": "/credit-climb/:path*", "destination": "/api/credit-climb?file=:path*" }
  ],
  "functions": {
    "api/credit-climb.js": {
      "includeFiles": "credit-climb/static/**"
    }
  }
}
